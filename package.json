{
  "name": "the-training-grounds",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "desktop:prepare": "vite build && rm -rf desktop/web && cp -R dist desktop/web",
    "desktop:start": "npm run desktop:prepare && electron desktop",
    "dist:win": "npm run desktop:prepare && electron-builder --win --x64",
    "dist:mac": "npm run desktop:prepare && electron-builder --mac --arm64 --x64",
    "test": "vitest run"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/share": "^8.0.3",
    "@google/genai": "^2.4.0",
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.180.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.180.0",
    "autoprefixer": "^10.4.21",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "build": {
    "appId": "com.trainingGrounds.fpvtrack",
    "productName": "Training Grounds",
    "directories": {
      "app": "desktop",
      "output": "release",
      "buildResources": "desktop"
    },
    "files": [
      "main.cjs",
      "icon.png",
      "web/**/*",
      "!**/node_modules/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "desktop/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "TrainingGrounds-Setup-${version}.exe",
      "shortcutName": "Training Grounds"
    },
    "portable": {
      "artifactName": "TrainingGrounds-Portable-${version}.exe"
    },
    "npmRebuild": false,
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "desktop/icon.png",
      "category": "public.app-category.graphics-design",
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "TrainingGrounds-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "Training Grounds ${version}"
    }
  },
  "description": "FPV drone racing track designer — 2D/3D editor, race line, lap times, share layouts",
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/abhjz/the-training-grounds.git"
  }
}
